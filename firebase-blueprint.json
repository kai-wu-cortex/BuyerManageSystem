{
  "entities": {
    "OrderItem": {
      "title": "OrderItem",
      "description": "An individual item in a purchase order",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "spec": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "orderedQty": { "type": "number" },
        "basicQty": { "type": "number" },
        "price": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "remark": { "type": "string" },
        "receivedQty": { "type": "number" },
        "rowExecutionStatus": { "type": "string" },
        "rowInboundStatus": { "type": "string" },
        "executedBasicQty": { "type": "number" },
        "executedQty": { "type": "number" },
        "unexecutedBasicQty": { "type": "number" },
        "unexecutedQty": { "type": "number" },
        "executedInboundQty": { "type": "number" },
        "executedNotInboundQty": { "type": "number" },
        "executionRate": { "type": "number" },
        "daysRemaining": { "type": "number" },
        "lastInboundDate": { "type": "string" },
        "customerName": { "type": "string" },
        "sourceOrderId": { "type": "string" },
        "inboundDate": { "type": "string" }
      },
      "required": ["code", "name", "spec", "category", "unit", "orderedQty", "price", "taxAmount", "remark", "receivedQty"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "A procurement purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "supplier": { "type": "string" },
        "status": { "type": "string", "enum": ["未审核", "已审核"] },
        "executionStatus": { "type": "string", "enum": ["未执行", "部分执行", "全部执行"] },
        "inboundStatus": { "type": "string", "enum": ["未入库", "部分入库", "全部入库"] },
        "discountRate": { "type": "number" },
        "discountAmount": { "type": "number" },
        "transportMethod": { "type": "string" },
        "settlementType": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "remarks": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "date", "supplier", "status", "executionStatus", "inboundStatus", "discountRate", "discountAmount", "transportMethod", "settlementType", "deliveryDate", "remarks", "items"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Stock inventory levels and thresholds",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "spec": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "safetyStock": { "type": "number" },
        "maxStock": { "type": "number" },
        "reorderPoint": { "type": "number" },
        "supplier": { "type": "string" }
      },
      "required": ["code", "name", "spec", "category", "unit", "currentStock", "safetyStock", "maxStock", "reorderPoint", "supplier"]
    },
    "SampleRecord": {
      "title": "SampleRecord",
      "description": "A trial or testing sample and tracking history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "spec": { "type": "string" },
        "category": { "type": "string" },
        "supplier": { "type": "string" },
        "requestDate": { "type": "string" },
        "status": { "type": "string", "enum": ["申请中", "寄送中", "已收到", "测试中", "合格启用", "不合格退回"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "courierInfo": { "type": "string" },
        "assignedTo": { "type": "string" },
        "notes": { "type": "string" },
        "imgUrl": { "type": "string" },
        "imgUrls": { "type": "array" },
        "poId": { "type": "string" }
      },
      "required": ["id", "name", "spec", "category", "supplier", "requestDate", "status", "quantity", "unit", "courierInfo", "assignedTo", "notes"]
    },
    "StickyNoteItem": {
      "title": "StickyNoteItem",
      "description": "An individual note line inside a sticky note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "noteText": { "type": "string" },
        "color": { "type": "string", "enum": ["yellow", "blue", "pink", "green"] },
        "updatedAt": { "type": "string" },
        "customBg": { "type": "string" }
      },
      "required": ["id", "noteText", "color", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Discussion comment on a PO sticky note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "content": { "type": "string" },
        "time": { "type": "string" }
      },
      "required": ["id", "author", "content", "time"]
    },
    "StickyNote": {
      "title": "StickyNote",
      "description": "All stickies and dialogue comments on a specific purchase order",
      "type": "object",
      "properties": {
        "poId": { "type": "string" },
        "noteText": { "type": "string" },
        "color": { "type": "string" },
        "updatedAt": { "type": "string" },
        "notesList": { "type": "array" },
        "comments": { "type": "array" }
      },
      "required": ["poId", "comments"]
    }
  },
  "firestore": {
    "purchase_orders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Stores purchase order lists"
    },
    "inventory_stock/{itemCode}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Stores standard inventory item metrics"
    },
    "sample_records/{sampleId}": {
      "schema": { "$ref": "#/entities/SampleRecord" },
      "description": "Stores testing sample records"
    },
    "order_sticky_notes/{poId}": {
      "schema": { "$ref": "#/entities/StickyNote" },
      "description": "Stores skeuomorphic sticky notes and discussion logs"
    }
  }
}
